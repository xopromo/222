# VK Application credentials
VK_CLIENT_ID=your_app_id
VK_CLIENT_SECRET=your_app_secret
VK_REDIRECT_URI=https://localhost:8000/api/v1/auth/callback

# VK API settings
VK_API_VERSION=5.199

# Application
APP_NAME=VK Ads Service
APP_VERSION=0.1.0
DEBUG=false
SECRET_KEY=change-me-in-production

# Database
DATABASE_URL=sqlite+aiosqlite:///./vk_ads.db

# Redis (optional, for token caching)
REDIS_URL=redis://localhost:6379/0
